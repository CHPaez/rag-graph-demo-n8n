# Normally generated by ./setup.sh. To do it by hand: cp .env.example .env

# --- Database (internal, not exposed) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me

# --- Neo4j (user is always 'neo4j'; bound to 127.0.0.1 only) ---
NEO4J_PASSWORD=change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
POSTGRES_DB=rag

# --- n8n ---
# Generate with: openssl rand -hex 24
# Keep it: n8n uses it to encrypt saved credentials.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_value
N8N_PORT=5679
GENERIC_TIMEZONE=America/Bogota

# --- Admin account created automatically on first start ---
# Leave OWNER_PASSWORD empty to create the account yourself in the web UI.
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=change_me
OWNER_FIRST_NAME=Demo
OWNER_LAST_NAME=RAG

# --- AI provider: "openai" or "gemini" ---
# gemini has a free tier (key from https://aistudio.google.com/apikey), but on the free tier
# Google may use what you send to improve its products. Do not use it with confidential manuals.
# Changing the provider needs re-vectorizing (the vectors are not compatible).
AI_PROVIDER=openai

# After changing a key: docker compose up -d --force-recreate n8n
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides for gemini:
# GEMINI_CHAT_MODEL=gemini-flash-latest   # alias that follows the current Flash model (gemini-2.5-flash is closed to new accounts)
# GEMINI_EMBED_MODEL=gemini-embedding-001
