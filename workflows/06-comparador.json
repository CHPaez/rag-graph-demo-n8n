    {
      "id": "f0000000-0000-4000-8000-000000000006",
      "name": "Armar comparacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        0
      ],
      "parameters": {
        "jsCode": "const fmtSteps = (steps) => (steps || []).map((s, i) => {\n  const tool = s.action?.tool || '?';\n  const input = JSON.stringify(s.action?.toolInput ?? {});\n  let obs = typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation);\n  obs = (obs || '').replace(/\\s+/g, ' ');\n  return `  ${i + 1}. ${tool}(${input}) -> ${obs.slice(0, 500)}${obs.length > 500 ? '...' : ''}`;\n}).join('\\n') || '  (sin llamadas a herramientas)';\nconst part = (title, nodeName) => {\n  const r = $(nodeName).first().json;\n  const body = r.body || {};\n  const answer = body.output || (r.statusCode >= 400 ? `ERROR ${r.statusCode}: ${JSON.stringify(body).slice(0, 300)}` : JSON.stringify(body).slice(0, 300));\n  return `## ${title}\\n${answer}\\n\\nRecuperacion:\\n${fmtSteps(body.intermediateSteps)}`;\n};\nconst q = $('Preparar pregunta').first().json.question;\nreturn [{ json: { question: q, output: `# Pregunta: ${q}\\n\\n` + [part('RAG vectorial', 'Vector'), part('GraphRAG', 'Grafo'), part('Hibrido', 'Hibrido')].join('\\n\\n') } }];"
      }
    }
  ],
